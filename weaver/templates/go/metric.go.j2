{%- if is_exported %}
{%- set field_name = smart_title_case(metric.metric_name) ~ smart_title_case(metric.instrument) %}
{%- else %}
{%- set field_name = lower_first(smart_title_case(metric.metric_name)) ~ smart_title_case(metric.instrument) %}
{%- endif %}
{%- set metric_meter_name = metric.annotations.meter if metric.annotations and metric.annotations.meter else registry_name %}
{%- set meter_var = lower_first(smart_title_case(metric_meter_name)) ~ "Meter" %}
{%- set is_float64 = metric.annotations and metric.annotations.histogram and metric.annotations.histogram.type and metric.annotations.histogram.type[:7] == "Float64" %}
